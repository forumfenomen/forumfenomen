"use client";

import {
  useEffect,
  useState,
  type FormEvent,
} from "react";

import InfoPageShell from "@/components/info-page-shell";
import {
  getForumLanguage,
  type ForumLanguage,
} from "@/lib/forumfenomen-language";

import styles from "@/components/info-pages.module.css";

const copy = {
  tr: {
    eyebrow: "ForumFenomen",
    title: "İletişim",
    description:
      "Soruların, iş birliği taleplerin ve toplulukla ilgili bildirimlerin için bizimle iletişime geçebilirsin.",

    cards: [
      {
        label: "Genel",
        title: "Genel İletişim",
        text:
          "ForumFenomen, üyelik, profil ve genel kullanım hakkındaki sorular için.",
      },
      {
        label: "İş Birliği",
        title: "Marka ve Reklam",
        text:
          "Reklam alanları, marka iş birlikleri ve kurumsal projeler için.",
      },
      {
        label: "Yasal",
        title: "KVKK, Telif ve İhlal",
        text:
          "Kişisel veri başvuruları, telif bildirimleri ve içerik ihlalleri için.",
      },
    ],

    formLabel: "İletişim Formu",
    formTitle: "Bize Mesaj Gönder",
    name: "Ad Soyad",
    email: "E-posta",
    subject: "Konu",
    message: "Mesaj",
    select: "Bir konu seç",
    general: "Genel iletişim",
    brand: "Marka ve reklam",
    legal: "KVKK, telif veya ihlal",
    send: "Mesajı Gönder",

    demo:
      "Form tasarımı hazır. Gerçek gönderim sistemi iletişim altyapısı bağlandığında aktif olacak.",
  },

  en: {
    eyebrow: "ForumFenomen",
    title: "Contact",
    description:
      "Contact us about questions, collaboration requests and community reports.",

    cards: [
      {
        label: "General",
        title: "General Contact",
        text:
          "For questions about ForumFenomen, membership, profiles and general usage.",
      },
      {
        label: "Collaboration",
        title: "Brand and Advertising",
        text:
          "For advertising spaces, brand partnerships and corporate projects.",
      },
      {
        label: "Legal",
        title: "Privacy, Copyright and Reports",
        text:
          "For personal data requests, copyright notices and content violations.",
      },
    ],

    formLabel: "Contact Form",
    formTitle: "Send Us a Message",
    name: "Full Name",
    email: "Email",
    subject: "Subject",
    message: "Message",
    select: "Choose a subject",
    general: "General contact",
    brand: "Brand and advertising",
    legal: "Privacy, copyright or violation",
    send: "Send Message",

    demo:
      "The form design is ready. Real sending will become active when the contact infrastructure is connected.",
  },
} as const;

export default function ContactPage() {
  const [language, setLanguage] =
    useState<ForumLanguage>("tr");

  const [submitted, setSubmitted] =
    useState(false);

  useEffect(() => {
    setLanguage(getForumLanguage());
  }, []);

  const t = copy[language];

  function handleSubmit(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();
    setSubmitted(true);
  }

  return (
    <InfoPageShell
      language={language}
      eyebrow={t.eyebrow}
      title={t.title}
      description={t.description}
    >
      <div className={styles.contactLayout}>
        <div className={styles.contactCards}>
          {t.cards.map((card) => (
            <article
              key={card.title}
              className={styles.contactCard}
            >
              <span>{card.label}</span>

              <h2>{card.title}</h2>

              <p>{card.text}</p>
            </article>
          ))}
        </div>

        <form
          className={styles.contactForm}
          onSubmit={handleSubmit}
        >
          <span>{t.formLabel}</span>

          <h2>{t.formTitle}</h2>

          <div className={styles.formGrid}>
            <div className={styles.field}>
              <label htmlFor="contact-name">
                {t.name}
              </label>

              <input
                id="contact-name"
                type="text"
                required
              />
            </div>

            <div className={styles.field}>
              <label htmlFor="contact-email">
                {t.email}
              </label>

              <input
                id="contact-email"
                type="email"
                required
              />
            </div>

            <div
              className={`${styles.field} ${styles.fieldFull}`}
            >
              <label htmlFor="contact-subject">
                {t.subject}
              </label>

              <select
                id="contact-subject"
                required
                defaultValue=""
              >
                <option value="" disabled>
                  {t.select}
                </option>

                <option value="general">
                  {t.general}
                </option>

                <option value="brand">
                  {t.brand}
                </option>

                <option value="legal">
                  {t.legal}
                </option>
              </select>
            </div>

            <div
              className={`${styles.field} ${styles.fieldFull}`}
            >
              <label htmlFor="contact-message">
                {t.message}
              </label>

              <textarea
                id="contact-message"
                required
              />
            </div>
          </div>

          <button
            type="submit"
            className={styles.submitButton}
          >
            {t.send}
          </button>

          {submitted && (
            <div className={styles.formNotice}>
              {t.demo}
            </div>
          )}
        </form>
      </div>
    </InfoPageShell>
  );
}
