.footer {
  position: relative;

  width: min(
    calc(100% - 24px),
    900px
  );

  margin:
    20px auto 4px;

  color: #d7d8e0;
}

.inner {
  display: grid;
  grid-template-columns:
    minmax(170px, 0.8fr)
    minmax(0, 1.5fr);

  align-items: center;
  gap: 18px 25px;

  min-height: 128px;

  padding: 20px 24px;

  overflow: hidden;

  border:
    1px solid
    rgba(204, 61, 233, 0.17);

  border-radius: 23px;

  background:
    radial-gradient(
      circle at 0 100%,
      rgba(217, 54, 231, 0.1),
      transparent 36%
    ),
    radial-gradient(
      circle at 100% 0,
      rgba(61, 113, 255, 0.1),
      transparent 36%
    ),
    rgba(8, 8, 18, 0.92);

  box-shadow:
    0 17px 38px
    rgba(0, 0, 0, 0.18),
    inset 0 1px 0
    rgba(255, 255, 255, 0.035);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.brandArea {
  min-width: 0;
}

.logo {
  display: block;

  width: 174px;
  height: auto;

  object-fit: contain;
}

.brandArea p {
  margin: 7px 0 0;

  color: #9699a6;

  font-size: 12px;
  font-weight: 530;
}

.links {
  display: flex;

  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;

  gap: 7px 9px;
}

.links button {
  min-height: 30px;

  padding: 0;

  color: #c5c7d1;

  border: 0;

  background: transparent;

  font: inherit;
  font-size: 11.5px;
  font-weight: 650;

  cursor: pointer;

  transition:
    color 0.18s ease,
    text-shadow 0.18s ease;
}

.links button:hover {
  color: #e765ed;

  text-shadow:
    0 0 14px
    rgba(224, 74, 235, 0.25);
}

.links span {
  color: #555866;

  font-size: 8px;
}

.copyright {
  grid-column: 1 / -1;

  display: flex;

  align-items: center;
  justify-content: center;
  flex-wrap: wrap;

  gap: 6px;

  padding-top: 14px;

  color: #777a87;

  border-top:
    1px solid
    rgba(255, 255, 255, 0.055);

  font-size: 10px;
  font-weight: 520;
}

.copyright span {
  color: #d35bdd;
}

.notice {
  position: fixed;

  left: 50%;
  bottom:
    calc(
      102px +
      env(safe-area-inset-bottom)
    );

  z-index: 2500;

  width: max-content;
  max-width:
    calc(100% - 28px);

  padding: 11px 15px;

  color: #f6f4f8;

  border:
    1px solid
    rgba(218, 67, 235, 0.3);

  border-radius: 13px;

  background:
    rgba(19, 13, 27, 0.97);

  box-shadow:
    0 14px 32px
    rgba(0, 0, 0, 0.32);

  font-size: 11px;
  font-weight: 650;
  line-height: 1.45;

  text-align: center;

  transform: translateX(-50%);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* AÇIK TEMA */

:global(html[data-theme="light"])
.footer {
  color: #292831;
}

:global(html[data-theme="light"])
.inner {
  border-color:
    rgba(53, 47, 77, 0.09);

  background:
    radial-gradient(
      circle at 0 100%,
      rgba(217, 54, 231, 0.06),
      transparent 36%
    ),
    radial-gradient(
      circle at 100% 0,
      rgba(61, 113, 255, 0.06),
      transparent 36%
    ),
    rgba(255, 255, 255, 0.96);

  box-shadow:
    0 13px 32px
    rgba(44, 39, 68, 0.07),
    inset 0 1px 0 #ffffff;
}

:global(html[data-theme="light"])
.brandArea p {
  color: #666976;
}

:global(html[data-theme="light"])
.links button {
  color: #4d4f5b;
}

:global(html[data-theme="light"])
.links button:hover {
  color: #b72fca;
}

:global(html[data-theme="light"])
.links span {
  color: #a0a2ad;
}

:global(html[data-theme="light"])
.copyright {
  color: #747783;

  border-top-color:
    rgba(43, 38, 65, 0.08);
}

:global(html[data-theme="light"])
.notice {
  color: #292831;

  border-color:
    rgba(179, 52, 201, 0.2);

  background:
    rgba(255, 255, 255, 0.98);

  box-shadow:
    0 13px 30px
    rgba(43, 38, 68, 0.14);
}

/* MOBİL */

@media (max-width: 680px) {
  .footer {
    width:
      calc(100% - 14px);

    margin-top: 14px;
  }

  .inner {
    grid-template-columns: 1fr;

    gap: 13px;

    min-height: 0;

    padding: 17px 15px;

    border-radius: 19px;

    text-align: center;
  }

  .brandArea {
    display: grid;
    justify-items: center;
  }

  .logo {
    width: 161px;
  }

  .brandArea p {
    margin-top: 5px;

    font-size: 11px;
  }

  .links {
    justify-content: center;

    gap: 4px 8px;
  }

  .links button {
    min-height: 27px;

    font-size: 10.5px;
  }

  .copyright {
    grid-column: auto;

    padding-top: 12px;

    font-size: 9.5px;
    line-height: 1.5;
  }

  .notice {
    bottom:
      calc(
        96px +
        env(safe-area-inset-bottom)
      );

    font-size: 10.5px;
  }
}

@media (max-width: 390px) {
  .links {
    max-width: 290px;

    margin: 0 auto;
  }
}

/* FORUM FOOTER WIDTH ALIGNMENT V2 START */

/*
  Ana içerik ve sabit alt navigasyon 820px genişliğinde.
  Footer artık hiçbir sayfada bu sınırların dışına çıkmaz.
*/

.footer {
  position: relative !important;

  left: auto !important;
  right: auto !important;

  width: calc(100% - 32px) !important;
  max-width: 820px !important;

  margin-left: auto !important;
  margin-right: auto !important;

  box-sizing: border-box !important;

  transform: none !important;
}

.inner {
  width: 100% !important;
  max-width: 100% !important;

  box-sizing: border-box !important;
}

/* Tablet */

@media (max-width: 860px) {
  .footer {
    width: calc(100% - 28px) !important;
    max-width: 820px !important;
  }
}

/*
  Mobilde footer ve sabit alt menü aynı yan boşlukla ilerler.
  Footer alt menünün arkasında kalmaz.
*/

@media (max-width: 680px) {
  .footer {
    width: calc(100% - 28px) !important;

    margin-top: 18px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    margin-bottom:
      calc(
        102px +
        env(safe-area-inset-bottom)
      ) !important;
  }

  .inner {
    width: 100% !important;
  }
}

/* FORUM FOOTER WIDTH ALIGNMENT V2 END */











/* FOOTER FINAL HOME LIFT V8 START */

/*
  GENEL SAYFALAR
  Kategoriler, Blog, Profil ve Konu Oluştur değişmez.
*/

.footer {
  margin-top: 14px !important;
  margin-bottom: 14px !important;
}

.brandArea {
  overflow: visible !important;
}

.logo {
  transform: scale(1.34) !important;
  transform-origin: left center !important;
}

.brandArea p {
  margin-top: 15px !important;
}

.links {
  align-self: center !important;
}

.copyright {
  padding-top: 9px !important;
}

/*
  ANA SAYFA

  Üst konum korunur.
  Alt boşluk artırılarak footer,
  sabit menüden yaklaşık 20px daha yukarı alınır.
*/

.homeFooter {
  margin-top: -68px !important;

  margin-bottom:
    calc(
      128px +
      env(safe-area-inset-bottom)
    ) !important;
}

/* TABLET */

@media (max-width: 860px) {
  .logo {
    transform: scale(1.31) !important;
  }

  .homeFooter {
    margin-top: -48px !important;

    margin-bottom:
      calc(
        122px +
        env(safe-area-inset-bottom)
      ) !important;
  }
}

/* MOBİL */

@media (max-width: 680px) {
  .footer {
    margin-top: 12px !important;
    margin-bottom: 14px !important;
  }

  .logo {
    transform: scale(1.34) !important;
    transform-origin: center center !important;
  }

  .brandArea p {
    margin-top: 16px !important;
  }

  .links {
    margin-top: -2px !important;
  }

  .copyright {
    padding-top: 8px !important;
  }

  .homeFooter {
    margin-top: -34px !important;

    margin-bottom:
      calc(
        112px +
        env(safe-area-inset-bottom)
      ) !important;
  }
}

/* DAR MOBİL */

@media (max-width: 390px) {
  .logo {
    transform: scale(1.29) !important;
  }

  .homeFooter {
    margin-top: -28px !important;

    margin-bottom:
      calc(
        108px +
        env(safe-area-inset-bottom)
      ) !important;
  }
}

/* FOOTER FINAL HOME LIFT V8 END */

/* MOBILE HOME FOOTER FINAL ALIGNMENT V9 START */

/*
  Yalnızca mobil ANA SAYFA footer düzenlemesi:

  1. Footer toplam 20px genişletilir.
  2. Reklam-footer arasındaki fazla boşluk 24px azaltılır.
  3. Footer-alt menü güvenli boşluğu korunur.
*/

@media (max-width: 680px) {
  .homeFooter {
    width: calc(100% - 8px) !important;
    max-width: none !important;

    margin-left: auto !important;
    margin-right: auto !important;

    margin-top: -58px !important;

    margin-bottom:
      calc(
        112px +
        env(safe-area-inset-bottom)
      ) !important;

    box-sizing: border-box !important;
  }

  .homeFooter .inner {
    width: 100% !important;
    max-width: 100% !important;

    box-sizing: border-box !important;
  }
}

/* Daha dar telefonlarda taşmayı önleyen ince ayar */

@media (max-width: 390px) {
  .homeFooter {
    width: calc(100% - 8px) !important;

    margin-top: -52px !important;

    margin-bottom:
      calc(
        108px +
        env(safe-area-inset-bottom)
      ) !important;
  }
}

/* MOBILE HOME FOOTER FINAL ALIGNMENT V9 END */
