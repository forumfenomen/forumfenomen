.grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 10px;
}

.card,
.wideCard,
.contactForm,
.documentCard,
.documentSection,
.noticeCard {
  border:
    1px solid
    rgba(255, 255, 255, 0.065);

  border-radius: 20px;

  background:
    rgba(8, 8, 18, 0.9);

  box-shadow:
    0 13px 30px
    rgba(0, 0, 0, 0.14);
}

.card {
  min-height: 165px;

  padding: 20px;
}

.cardNumber {
  display: grid;

  width: 37px;
  height: 37px;

  place-items: center;

  color: #e060e8;

  border:
    1px solid
    rgba(211, 63, 233, 0.25);

  border-radius: 12px;

  background:
    rgba(207, 54, 230, 0.07);

  font-size: 10px;
  font-weight: 850;
}

.card h2,
.wideCard h2,
.contactForm h2,
.documentSection h2,
.noticeCard h2 {
  margin: 15px 0 0;

  color: #ffffff;

  font-size: 19px;
  line-height: 1.3;
}

.card p,
.wideCard p,
.documentSection p,
.noticeCard p {
  margin: 9px 0 0;

  color: #a8abb6;

  font-size: 12px;
  line-height: 1.65;
}

.wideCard {
  margin-top: 10px;

  padding: 24px;
}

.tagList {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;

  margin-top: 17px;
}

.tagList span {
  display: inline-flex;
  min-height: 35px;

  align-items: center;

  padding: 0 12px;

  color: #d97ce2;

  border:
    1px solid
    rgba(211, 64, 233, 0.2);

  border-radius: 999px;

  background:
    rgba(208, 54, 230, 0.055);

  font-size: 10.5px;
  font-weight: 700;
}

.actionRow {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;

  margin-top: 18px;
}

.primaryButton,
.secondaryButton {
  display: inline-flex;
  min-height: 42px;

  align-items: center;
  justify-content: center;

  padding: 0 16px;

  border-radius: 12px;

  font-size: 11px;
  font-weight: 750;

  text-decoration: none;
}

.primaryButton {
  color: #ffffff;

  border:
    1px solid
    rgba(221, 72, 237, 0.38);

  background:
    linear-gradient(
      135deg,
      #bc35dd,
      #4c69ff
    );
}

.secondaryButton {
  color: #c9cbd4;

  border:
    1px solid
    rgba(255, 255, 255, 0.085);

  background:
    rgba(255, 255, 255, 0.025);
}

.contactLayout {
  display: grid;
  grid-template-columns:
    0.78fr 1.22fr;

  align-items: start;
  gap: 10px;
}

.contactCards {
  display: grid;
  gap: 10px;
}

.contactCard {
  padding: 18px;

  border:
    1px solid
    rgba(255, 255, 255, 0.065);

  border-radius: 18px;

  background:
    rgba(8, 8, 18, 0.9);
}

.contactCard span {
  color: #dc5de5;

  font-size: 9px;
  font-weight: 850;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.contactCard h2 {
  margin: 7px 0 0;

  color: #ffffff;

  font-size: 16px;
}

.contactCard p {
  margin: 7px 0 0;

  color: #a5a8b3;

  font-size: 11px;
  line-height: 1.55;
}

.contactForm {
  padding: 22px;
}

.contactForm > span {
  color: #d957e3;

  font-size: 9px;
  font-weight: 850;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.formGrid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 9px;

  margin-top: 18px;
}

.field {
  display: grid;
  gap: 7px;
}

.fieldFull {
  grid-column: 1 / -1;
}

.field label {
  color: #c3c5ce;

  font-size: 10.5px;
  font-weight: 700;
}

.field input,
.field select,
.field textarea {
  width: 100%;

  color: #ffffff;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-radius: 12px;

  background:
    rgba(255, 255, 255, 0.022);

  outline: 0;

  font: inherit;
  font-size: 12px;
}

.field input,
.field select {
  min-height: 45px;

  padding: 0 12px;
}

.field textarea {
  min-height: 145px;

  resize: vertical;

  padding: 13px;

  line-height: 1.6;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color:
    rgba(212, 61, 234, 0.42);

  box-shadow:
    0 0 0 3px
    rgba(208, 54, 231, 0.055);
}

.submitButton {
  display: inline-flex;
  min-height: 44px;

  align-items: center;
  justify-content: center;

  margin-top: 12px;
  padding: 0 18px;

  color: #ffffff;

  border:
    1px solid
    rgba(220, 70, 236, 0.35);

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #bd36dd,
      #4b6bff
    );

  font-size: 11px;
  font-weight: 760;

  cursor: pointer;
}

.formNotice {
  margin-top: 12px;

  padding: 11px 13px;

  color: #9ae2c7;

  border:
    1px solid
    rgba(57, 198, 151, 0.21);

  border-radius: 12px;

  background:
    rgba(44, 167, 125, 0.07);

  font-size: 10.5px;
  line-height: 1.5;
}

.legalGrid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 10px;
}

.documentCard {
  position: relative;

  display: grid;
  grid-template-columns:
    44px
    minmax(0, 1fr)
    24px;

  min-height: 125px;

  align-items: center;
  gap: 12px;

  padding: 17px;

  color: inherit;
  text-decoration: none;

  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

.documentCard:hover {
  transform: translateY(-2px);

  border-color:
    rgba(211, 61, 233, 0.28);

  box-shadow:
    0 16px 34px
    rgba(0, 0, 0, 0.18);
}

.documentIcon {
  display: grid;

  width: 43px;
  height: 43px;

  place-items: center;

  color: #df63e7;

  border:
    1px solid
    rgba(210, 61, 232, 0.23);

  border-radius: 13px;

  background:
    rgba(207, 54, 230, 0.07);

  font-size: 13px;
  font-weight: 850;
}

.documentCard h2 {
  margin: 0;

  color: #ffffff;

  font-size: 15px;
  line-height: 1.3;
}

.documentCard p {
  margin: 6px 0 0;

  color: #a2a5b0;

  font-size: 10.5px;
  line-height: 1.5;
}

.documentArrow {
  color: #7d808c;

  font-size: 22px;
}

.documentMeta {
  display: flex;
  flex-wrap: wrap;

  gap: 7px;

  margin-bottom: 10px;
}

.draftBadge,
.updateBadge {
  display: inline-flex;
  min-height: 29px;

  align-items: center;

  padding: 0 10px;

  border-radius: 999px;

  font-size: 9.5px;
  font-weight: 750;
}

.draftBadge {
  color: #e57cec;

  border:
    1px solid
    rgba(212, 62, 234, 0.24);

  background:
    rgba(208, 54, 230, 0.065);
}

.updateBadge {
  color: #92cfff;

  border:
    1px solid
    rgba(59, 159, 245, 0.21);

  background:
    rgba(50, 147, 235, 0.06);
}

.noticeCard {
  margin-bottom: 10px;

  padding: 18px;
}

.noticeCard h2 {
  margin-top: 0;
}

.documentSections {
  display: grid;
  gap: 10px;
}

.documentSection {
  padding: 21px;
}

.documentSection h2 {
  margin-top: 0;

  font-size: 17px;
}

.backLink {
  display: inline-flex;
  min-height: 39px;

  align-items: center;

  margin-top: 12px;
  padding: 0 13px;

  color: #d477df;

  border:
    1px solid
    rgba(207, 61, 231, 0.22);

  border-radius: 11px;

  background:
    rgba(207, 54, 230, 0.055);

  font-size: 10.5px;
  font-weight: 730;

  text-decoration: none;
}

:global(html[data-theme="light"]) .card,
:global(html[data-theme="light"]) .wideCard,
:global(html[data-theme="light"]) .contactForm,
:global(html[data-theme="light"]) .contactCard,
:global(html[data-theme="light"]) .documentCard,
:global(html[data-theme="light"]) .documentSection,
:global(html[data-theme="light"]) .noticeCard {
  border-color:
    rgba(43, 38, 65, 0.085);

  background:
    rgba(255, 255, 255, 0.97);

  box-shadow:
    0 11px 27px
    rgba(43, 38, 68, 0.06);
}

:global(html[data-theme="light"]) .card h2,
:global(html[data-theme="light"]) .wideCard h2,
:global(html[data-theme="light"]) .contactForm h2,
:global(html[data-theme="light"]) .contactCard h2,
:global(html[data-theme="light"]) .documentCard h2,
:global(html[data-theme="light"]) .documentSection h2,
:global(html[data-theme="light"]) .noticeCard h2 {
  color: #24232b;
}

:global(html[data-theme="light"]) .card p,
:global(html[data-theme="light"]) .wideCard p,
:global(html[data-theme="light"]) .contactCard p,
:global(html[data-theme="light"]) .documentCard p,
:global(html[data-theme="light"]) .documentSection p,
:global(html[data-theme="light"]) .noticeCard p {
  color: #646773;
}

:global(html[data-theme="light"]) .field label {
  color: #4d4f5a;
}

:global(html[data-theme="light"]) .field input,
:global(html[data-theme="light"]) .field select,
:global(html[data-theme="light"]) .field textarea {
  color: #26252d;

  border-color:
    rgba(43, 38, 65, 0.1);

  background:
    rgba(44, 39, 67, 0.025);
}

@media (max-width: 680px) {
  .grid,
  .legalGrid,
  .contactLayout {
    grid-template-columns: 1fr;
  }

  .card {
    min-height: 0;

    padding: 17px;
  }

  .card h2,
  .wideCard h2 {
    font-size: 17px;
  }

  .card p,
  .wideCard p {
    font-size: 11px;
  }

  .wideCard {
    padding: 18px;
  }

  .contactForm {
    padding: 17px;
  }

  .formGrid {
    grid-template-columns: 1fr;
  }

  .fieldFull {
    grid-column: auto;
  }

  .documentCard {
    min-height: 112px;

    padding: 14px;
  }

  .documentSection {
    padding: 17px;
  }
}

/* CONTACT REAL EMAILS V2 START */

.contactCard {
  position: relative;

  overflow: hidden;
}

.contactCard::after {
  content: "";

  position: absolute;
  top: -55px;
  right: -55px;

  width: 125px;
  height: 125px;

  pointer-events: none;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(207, 57, 233, 0.085),
      transparent 68%
    );
}

.contactEmailLink {
  position: relative;
  z-index: 2;

  display: inline-flex;
  min-height: 37px;

  align-items: center;
  gap: 8px;

  max-width: 100%;

  margin-top: 13px;
  padding: 0 11px;

  overflow: hidden;

  color: #df78e7;

  border:
    1px solid
    rgba(210, 63, 232, 0.22);

  border-radius: 11px;

  background:
    rgba(207, 54, 230, 0.055);

  font-size: 10.5px;
  font-weight: 720;

  text-decoration: none;
  text-overflow: ellipsis;
  white-space: nowrap;

  transition:
    color 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease,
    transform 0.18s ease;
}

.contactEmailLink:hover {
  color: #ffffff;

  border-color:
    rgba(222, 76, 239, 0.43);

  background:
    rgba(207, 54, 230, 0.11);

  transform: translateY(-1px);
}

.contactEmailLink i {
  display: grid;
  width: 21px;
  height: 21px;

  flex: 0 0 21px;
  place-items: center;

  color: #ffffff;

  border-radius: 7px;

  background:
    linear-gradient(
      135deg,
      #d643e2,
      #586fff
    );

  font-size: 11px;
  font-style: normal;
  font-weight: 850;
}

.contactFormDescription {
  margin: 8px 0 0;

  color: #9fa2ad;

  font-size: 11px;
  line-height: 1.55;
}

:global(html[data-theme="light"])
.contactEmailLink {
  color: #a62cba;

  border-color:
    rgba(176, 48, 199, 0.18);

  background:
    rgba(198, 52, 219, 0.05);
}

:global(html[data-theme="light"])
.contactEmailLink:hover {
  color: #7e1e8e;

  border-color:
    rgba(176, 48, 199, 0.34);

  background:
    rgba(198, 52, 219, 0.09);
}

:global(html[data-theme="light"])
.contactFormDescription {
  color: #666976;
}

@media (max-width: 680px) {
  .contactEmailLink {
    width: 100%;

    justify-content: center;

    font-size: 10px;
  }

  .contactFormDescription {
    font-size: 10.5px;
  }
}

/* CONTACT REAL EMAILS V2 END */

/* CONTACT MESSAGE FORM V3 START */

/* Zorunlu alan göstergeleri */

.requiredInfo {
  display: flex;
  align-items: center;
  gap: 6px;

  width: fit-content;

  margin-top: 12px;
  padding: 6px 9px;

  color: #a7a9b4;

  border:
    1px solid
    rgba(255, 255, 255, 0.065);

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.02);

  font-size: 9px;
  font-weight: 620;
}

.requiredInfo i,
.requiredMark {
  color: #e95be8;

  font-style: normal;
  font-weight: 850;
}

.requiredMark {
  margin-left: 4px;
}

/* Açılır menü koyu temada okunabilir */

.field select {
  color-scheme: dark;

  cursor: pointer;
}

.field select option {
  color: #f4f4f7;

  background-color: #0b0b15;

  font-size: 12px;
}

/* Seçili olmayan ilk seçenek */

.field select:invalid {
  color: #858895;
}

.field select:valid {
  color: #ffffff;
}

/* Gönder butonu */

.submitButton {
  min-width: 160px;

  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    filter 0.18s ease;
}

.submitButton:hover {
  transform: translateY(-1px);

  box-shadow:
    0 9px 20px
    rgba(175, 52, 221, 0.2);

  filter: brightness(1.06);
}

.submitButton:active {
  transform: translateY(0);
}

/* Açık tema */

:global(html[data-theme="light"])
.requiredInfo {
  color: #646773;

  border-color:
    rgba(43, 38, 65, 0.09);

  background:
    rgba(43, 38, 65, 0.025);
}

:global(html[data-theme="light"])
.field select {
  color-scheme: light;
}

:global(html[data-theme="light"])
.field select option {
  color: #26252d;

  background-color: #ffffff;
}

:global(html[data-theme="light"])
.field select:invalid {
  color: #777a86;
}

:global(html[data-theme="light"])
.field select:valid {
  color: #26252d;
}

/* Mobil */

@media (max-width: 680px) {
  .requiredInfo {
    margin-top: 10px;

    font-size: 8.8px;
  }

  .submitButton {
    width: 100%;
  }
}

/* CONTACT MESSAGE FORM V3 END */
